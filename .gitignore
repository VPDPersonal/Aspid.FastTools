.zed/
.DS_Store

# UPM convention: `Samples~` is hidden from Unity importer but must be tracked.
# Override global `*~` ignore.
!Samples~/
!Samples~/**
/Aspid.FastTools/.codex/

# Generated at release by scripts/package-changelog.mjs; only the upm branches carry it.
/Aspid.FastTools/Packages/tech.aspid.fasttools/CHANGELOG.md
/Aspid.FastTools/Packages/tech.aspid.fasttools/CHANGELOG.md.meta

# Capture masters live in the private Aspid.Media.Storage repository, under FastTools/Docs/.
/docs/media/**/*.mkv
/docs/media/**/*.mov
