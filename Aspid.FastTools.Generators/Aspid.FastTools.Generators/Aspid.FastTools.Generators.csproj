<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <RootNamespace>Aspid.FastTools</RootNamespace>
        <!-- RS2008 expects analyzer release tracking files; this is a private in-tree generator, not a published analyzer package. -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>

        <!-- The built DLL is committed into the Unity package, so identical sources must yield an
             identical binary on any machine — which is what the release workflow's freshness gate
             rebuilds and diffs. Three things otherwise leak the build environment into the PE:
             the SDK's own SCM queries stamp the commit SHA into the assembly (so a merge commit
             with an identical tree produced different bytes), the debug directory carries a PDB id
             derived from absolute checkout paths, and the informational version repeats the SHA. -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
        <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Aspid.FastTools.Generators.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Exact versions, in brackets: a bare version is only a lower bound, and the DLL these are
             merged into is committed. 0.0.1-alpha.4 was never published — it resolved from this
             machine's NuGet cache locally while CI silently floated up to 0.1.0, so the shipped
             binary was built from something no other checkout could reproduce. -->
        <PackageReference Include="Aspid.Generators.Helper" Version="[0.1.0]" />
        <PackageReference Include="Aspid.Generators.Helper.Unity" Version="[0.0.1-alpha.3]" />
        <PackageReference ExcludeAssets="runtime" Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference ExcludeAssets="runtime" Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0"/>
        <!-- Merges Aspid.Generators.Helper* into the single DLL Unity references (see Directory.Build.targets).
             Never add SourceGenerator.Foundations here: its injected module initializer writes to Console,
             which deadlocks VBCSCompiler when the stdout pipe buffer fills. -->
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.45" PrivateAssets="all" />
    </ItemGroup>

</Project>
