<Project>

    <!-- Aspid.Generators.Helper* versions, shared by the generator (which merges them into the committed
         DLL) and the Sample (which loads them as analyzers next to the unmerged generator).
         Exact versions, in brackets: a bare version is only a lower bound, and the DLL these are
         merged into is committed. 0.0.1-alpha.4 was never published — it resolved from this
         machine's NuGet cache locally while CI silently floated up to 0.1.0, so the shipped
         binary was built from something no other checkout could reproduce. -->
    <PropertyGroup>
        <AspidGeneratorsHelperVersion>[0.1.0]</AspidGeneratorsHelperVersion>
        <AspidGeneratorsHelperUnityVersion>[0.0.1-alpha.3]</AspidGeneratorsHelperUnityVersion>
    </PropertyGroup>

</Project>
