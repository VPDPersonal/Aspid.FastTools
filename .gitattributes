# Line endings stay as committed (the font licences are CRLF);
# only files that stop working with CRLF are pinned to LF.
*.sh            text eol=lf

# Binary: no diff, no merge, no line-ending conversion.
*.dll           binary
*.png           binary
*.jpg           binary
*.gif           binary
*.mp4           binary
*.ttf           binary
*.woff2         binary
