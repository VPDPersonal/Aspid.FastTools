.aspid-fasttools-window-footer {
    flex-shrink:                                          0;
    margin-top:                                           2px;
    padding-bottom:                                       8px;
}

.aspid-fasttools-window-footer AspidDividingLine {
    opacity:                                              0.5;
}

.aspid-fasttools-window-footer__row {
    flex-direction:                                       row;
    justify-content:                                      space-between;
    margin-top:                                           5px;
    padding-left:                                         10px;
    padding-right:                                        10px;
}

.aspid-fasttools-window-footer__version {
    flex-shrink:                                          0;
    cursor:                                               link;
    color:                                                var(--aspid-colors-text-dark);
    font-size:                                            14px;
}

.aspid-fasttools-window-footer__version:hover {
    color:                                                var(--aspid-colors-text-light);
}

.aspid-fasttools-window-footer__keys {
    flex-grow:                                            1;
    flex-shrink:                                          1;
    margin-left:                                          8px;
    margin-right:                                         8px;
    overflow:                                             hidden;
    white-space:                                          nowrap;
    text-overflow:                                        ellipsis;
    font-size:                                            11px;
    color:                                                var(--aspid-colors-text-dark);
    -unity-text-align:                                    middle-center;
}

.aspid-fasttools-window-footer__link {
    flex-shrink:                                          0;
    cursor:                                               link;
    color:                                                var(--aspid-colors-status-success-text-dark);
    font-size:                                            14px;
    -unity-font-style:                                    bold;
}

.aspid-fasttools-window-footer__link:hover {
    color:                                                var(--aspid-colors-status-success-text-light);
}
