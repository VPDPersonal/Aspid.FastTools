:root {
    padding:                                                    8px 12px;
    border-width:                                               1px;
    border-radius:                                              8px;
    flex-direction:                                             row;
    align-items:                                                center;
    background-color:                                           var(--aspid-colors-bg-dark);
    border-color:                                               var(--aspid-colors-shade-light);
}

:root.aspid-fasttools-status--success {
    background-color:                                           var(--aspid-colors-status-success-light);
    border-color:                                               var(--aspid-colors-status-success-shade-lightness);
}

:root.aspid-fasttools-status--warning {
    background-color:                                           var(--aspid-colors-status-warning-light);
    border-color:                                               var(--aspid-colors-status-warning-shade-lightness);
}

:root.aspid-fasttools-status--error {
    background-color:                                           var(--aspid-colors-status-error-light);
    border-color:                                               var(--aspid-colors-status-error-shade-lightness);
}

:root.aspid-fasttools-status--info {
    background-color:                                           var(--aspid-colors-status-info-light);
    border-color:                                               var(--aspid-colors-status-info-shade-lightness);
}

.aspid-fasttools-help-box__icon {
    min-width:                                                  34px;
    max-width:                                                  34px;
    min-height:                                                 32px;
    max-height:                                                 32px;
    margin-right:                                               9px;
    background-size:                                            contain;
    background-repeat:                                          no-repeat;
    background-position:                                        center;
    background-image:                                           var(--aspid-fasttools-icons-help_box);
}

.aspid-fasttools-help-box__icon--hidden {
    display:                                                    none;
}

/* The icons follow the palette, not the editor skin: on the dark palette the box keeps the dark-skin icons on either
   skin, and in an Aspid window on the light skin it sits on a light fill and takes the light-skin icons. */
:root.aspid-fasttools-help-box--info {
    --aspid-fasttools-icons-help_box:                           resource("d_console.infoicon@2x");
}

:root.aspid-fasttools-help-box--warning {
    --aspid-fasttools-icons-help_box:                           resource("d_console.warnicon@2x");
}

:root.aspid-fasttools-help-box--error {
    --aspid-fasttools-icons-help_box:                           resource("d_console.erroricon@2x");
}

.aspid-fasttools-palette--light .aspid-fasttools-help-box--info {
    --aspid-fasttools-icons-help_box:                           resource("console.infoicon@2x");
}

.aspid-fasttools-palette--light .aspid-fasttools-help-box--warning {
    --aspid-fasttools-icons-help_box:                           resource("console.warnicon@2x");
}

.aspid-fasttools-palette--light .aspid-fasttools-help-box--error {
    --aspid-fasttools-icons-help_box:                           resource("console.erroricon@2x");
}

.aspid-fasttools-help-box__text-container {
    flex-grow:                                                  1;
}

.aspid-fasttools-help-box__title {
    margin-bottom:                                              4px;
}

:root AspidLabel > Label {
    cursor:                                                     text;
    overflow:                                                   hidden;
}
