/* Unity: the colours of Unity's own editor skin, so an Aspid window reads as one more editor panel. The canvas takes
   the tab strip of the editor (#141414 on the dark skin), the cards its panels (#383838) with their darker separators,
   and the drop-downs and value boxes its darker input fields. The accent stays green; the status and accent text is
   lifted on the dark skin and deepened on the light skin, so it keeps its contrast on the grey cards.
   The light block repeats every token of :root that Default-Light sets: :root here outranks Default-Light, and the
   light block follows :root in this sheet. */
:root {
    --aspid-colors-bg-darkness:                     rgb(48, 48, 48);
    --aspid-colors-bg-dark:                         rgb(64, 64, 64);
    --aspid-colors-bg-light:                        rgb(74, 74, 74);
    --aspid-colors-bg-lightness:                    rgb(86, 86, 86);

    --aspid-colors-text-lightness:                  rgb(232, 232, 232);
    --aspid-colors-text-light:                      rgb(212, 212, 212);
    --aspid-colors-text-dark:                       rgb(178, 178, 178);
    --aspid-colors-text-darkness:                   rgb(140, 140, 140);

    --aspid-colors-shade-darkness:                  rgb(35, 35, 35);
    --aspid-colors-shade-dark:                      rgb(82, 82, 82);
    --aspid-colors-shade-light:                     rgb(100, 100, 100);
    --aspid-colors-shade-lightness:                 rgb(118, 118, 118);

    --aspid-colors-surface-canvas:                  rgb(20, 20, 20);
    --aspid-colors-surface-card:                    rgb(56, 56, 56);
    --aspid-colors-surface-card-dim:                rgb(42, 42, 42);
    --aspid-colors-surface-field:                   rgb(42, 42, 42);

    --aspid-colors-slider-handle:                   rgba(200, 200, 200, 0.85);
    --aspid-colors-control-border:                  rgb(132, 132, 132);
    --aspid-colors-scope-user:                      rgb(138, 138, 138);
    --aspid-colors-dark-skin-text-darkness:         rgb(178, 178, 178);

    --aspid-colors-status-info-text-dark:           rgb(112, 170, 228);
    --aspid-colors-status-info-text-light:          rgb(140, 190, 240);
    --aspid-colors-status-error-text-light:         rgb(244, 136, 156);
}

.aspid-fasttools-palette--light {
    --aspid-colors-bg-darkness:                     rgb(214, 214, 214);
    --aspid-colors-bg-dark:                         rgb(204, 204, 204);
    --aspid-colors-bg-light:                        rgb(194, 194, 194);
    --aspid-colors-bg-lightness:                    rgb(182, 182, 182);

    --aspid-colors-text-lightness:                  rgb(9, 9, 9);
    --aspid-colors-text-light:                      rgb(28, 28, 28);
    --aspid-colors-text-dark:                       rgb(62, 62, 62);
    --aspid-colors-text-darkness:                   rgb(96, 96, 96);

    --aspid-colors-shade-darkness:                  rgb(153, 153, 153);
    --aspid-colors-shade-dark:                      rgb(178, 178, 178);
    --aspid-colors-shade-light:                     rgb(153, 153, 153);
    --aspid-colors-shade-lightness:                 rgb(128, 128, 128);

    --aspid-colors-surface-canvas:                  rgb(165, 165, 165);
    --aspid-colors-surface-card:                    rgb(200, 200, 200);
    --aspid-colors-surface-card-dim:                rgb(240, 240, 240);
    --aspid-colors-surface-field:                   rgb(240, 240, 240);

    --aspid-colors-slider-handle:                   rgba(80, 80, 80, 0.85);
    --aspid-colors-control-border:                  rgb(102, 102, 102);
    --aspid-colors-scope-user:                      rgb(100, 100, 100);

    --aspid-colors-status-info-text-dark:           rgb(18, 80, 134);
    --aspid-colors-status-info-text-light:          rgb(16, 74, 124);

    --aspid-colors-status-success-text-dark:        rgb(20, 100, 45);
    --aspid-colors-status-success-text-light:       rgb(15, 84, 37);
    --aspid-colors-status-success-text-lightness:   rgb(12, 70, 31);

    --aspid-colors-accent-text-dark:                rgb(16, 90, 40);
    --aspid-colors-accent-text-light:               rgb(15, 84, 37);
    --aspid-colors-accent-text-lightness:           rgb(12, 70, 31);

    --aspid-colors-status-warning-text-dark:        rgb(112, 76, 0);
    --aspid-colors-status-warning-text-light:       rgb(94, 64, 0);
    --aspid-colors-status-warning-text-lightness:   rgb(78, 53, 0);

    --aspid-colors-status-error-text-dark:          rgb(160, 40, 62);
    --aspid-colors-status-error-text-light:         rgb(138, 32, 52);
    --aspid-colors-status-error-text-lightness:     rgb(118, 26, 44);
}
