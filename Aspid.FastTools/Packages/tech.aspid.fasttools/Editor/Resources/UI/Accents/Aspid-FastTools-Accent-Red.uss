/* Red: the red of the documentation site accent and the red package logo.
   Layered after the theme, so it recolors the accent of any theme; the success status stays green. The light block
   follows :root, and :root here outranks Default-Light. */
:root {
    --aspid-icons-accent:                           resource("Icons/aspid_icon_medium_red_256x253");

    --aspid-colors-accent-shade-dark:               rgb(90, 45, 45);
    --aspid-colors-accent-text-darkness:            rgb(140, 56, 56);
    --aspid-colors-accent-text-dark:                rgb(224, 100, 100);
    --aspid-colors-accent-text-light:               rgb(234, 134, 134);
    --aspid-colors-accent-text-lightness:           rgb(242, 180, 180);
    --aspid-colors-accent-shade-light:              rgb(150, 70, 70);
    --aspid-colors-accent-tint:                     rgba(125, 35, 35, 0.25);

    /* Switches read their own token; on the dark skin an on switch tints its track with it. */
    --aspid-colors-switch-accent:                   rgb(224, 100, 100);
}

/* On the light skin an on switch fills its track under a white handle, inside a window or not. */
.aspid-fasttools-skin--light {
    --aspid-colors-switch-accent:                   rgb(224, 72, 72);
}

.aspid-fasttools-palette--light {
    --aspid-colors-accent-shade-dark:               rgb(228, 180, 180);
    --aspid-colors-accent-text-darkness:            rgb(225, 140, 140);
    --aspid-colors-accent-text-dark:                rgb(204, 64, 64);
    --aspid-colors-accent-text-light:               rgb(178, 57, 57);
    --aspid-colors-accent-text-lightness:           rgb(150, 46, 46);
    --aspid-colors-accent-shade-light:              rgb(225, 150, 150);
    --aspid-colors-accent-tint:                     rgba(220, 60, 60, 0.12);
}
