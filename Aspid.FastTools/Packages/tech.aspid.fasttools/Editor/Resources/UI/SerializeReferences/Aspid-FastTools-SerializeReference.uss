:root {
    margin:                                                 0;
}

/* Child combinators keep the header rules off the foldouts of nested properties. */
.aspid-fasttools-serialize-reference > .unity-foldout > .unity-foldout__toggle {
    flex-direction:                                         row;
    align-items:                                            center;
}

.aspid-fasttools-serialize-reference
    > .unity-foldout
    > .unity-foldout__toggle
    > .unity-foldout__input {
    flex-grow:                                              0;
    flex-shrink:                                            0;
}

.aspid-fasttools-serialize-reference__dropdown {
    flex-grow:                                              1;
}

/* Cancel the EnumField caption's built-in negative margin. */
.aspid-fasttools-serialize-reference__dropdown .unity-enum-field__text {
    margin-left:                                            0;
}

/* The bare TextElement does not inherit popup-field ellipsis rules, so all overflow properties are required here. */
.aspid-fasttools-serialize-reference__dropdown--missing .unity-enum-field__text {
    overflow:                                               hidden;
    white-space:                                            nowrap;
    text-overflow:                                          ellipsis;
    -unity-text-overflow-position:                          start;
    color:                                                  var(--unity-colors-warning-text);
}

/* The hidden arrow keeps its slot, so the label stays in column and a stripe hangs in the slot. */
.aspid-fasttools-serialize-reference--empty
    > .unity-foldout
    > .unity-foldout__toggle
    .unity-foldout__checkmark,
.aspid-fasttools-serialize-reference--childless
    > .unity-foldout
    > .unity-foldout__toggle
    .unity-foldout__checkmark {
    visibility:                                             hidden;
}

.aspid-fasttools-serialize-reference--striped.aspid-fasttools-serialize-reference--empty > .unity-foldout,
.aspid-fasttools-serialize-reference--striped.aspid-fasttools-serialize-reference--childless > .unity-foldout {
    padding-left:                                           0;
}

.aspid-fasttools-serialize-reference--striped.aspid-fasttools-serialize-reference--empty
    > .unity-foldout
    > .aspid-fasttools-serialize-reference__notices,
.aspid-fasttools-serialize-reference--striped.aspid-fasttools-serialize-reference--childless
    > .unity-foldout
    > .aspid-fasttools-serialize-reference__notices {
    margin-left:                                            0;
}

/* A class, not a type selector: buttons of nested drawers and lists share this subtree. */
Button.aspid-fasttools-serialize-reference__open-button {
    padding:                                                0;
    min-width:                                              18px;
    max-width:                                              18px;
    min-height:                                             18px;
    max-height:                                             18px;
    margin:                                                 0 0 0 1px;
}

.aspid-fasttools-serialize-reference__open-button > VisualElement {
    width:                                                  100%;
    height:                                                 100%;
    background-image:                                       resource("d_Folder Icon");
}

.aspid-fasttools-serialize-reference__open-button > VisualElement:enabled:hover {
    background-image:                                       resource("d_FolderOpened Icon");
}

.aspid-fasttools-serialize-reference.aspid-fasttools-skin--light .aspid-fasttools-serialize-reference__open-button > VisualElement {
    background-image:                                       resource("Folder Icon");
}

.aspid-fasttools-serialize-reference.aspid-fasttools-skin--light .aspid-fasttools-serialize-reference__open-button > VisualElement:enabled:hover {
    background-image:                                       resource("FolderOpened Icon");
}

/* A field overridden on a prefab instance: Unity's bold override label, set by hand on this unbound header. */
.aspid-fasttools-serialize-reference--prefab-override
    > .unity-foldout
    > .unity-foldout__toggle
    > .unity-base-field__label {
    -unity-font-style:                                      bold;
}

/* Use padding to preserve Unity's margin-based foldout nesting indent. */
.aspid-fasttools-serialize-reference--striped > .unity-foldout {
    padding-left:                                         8px;
}

.aspid-fasttools-serialize-reference__stripe {
    margin-left:                                           0;
    position:                                              absolute;
    left:                                                  2px;
    top:                                                   0;
    bottom:                                                0;
    width:                                                 0;
}

.aspid-fasttools-serialize-reference__stripe--active {
    margin-left:                                           -11px;
    width:                                                 2px;
}

.aspid-fasttools-serialize-reference__stripe--warning {
    background-color:                                      var(--unity-colors-warning-text);
}

.aspid-fasttools-serialize-reference__flash {
    position:                                              absolute;
    left:                                                  2px;
    margin-left:                                           -11px;
    right:                                                 0;
    top:                                                   0;
    bottom:                                                0;
}

/* The swatch of a shared notice sits under the arrow, and its text starts under the label. */
.aspid-fasttools-serialize-reference--striped
    > .unity-foldout
    > .aspid-fasttools-serialize-reference__notices {
    margin-left:                                           -15px;
}

/* Prevent flex compression so tall content scrolls instead of collapsing its cards. */
.aspid-fasttools-repair-references__content {
    flex-grow:                                             1;
    flex-shrink:                                           0;
    padding:                                               12px;
}

.aspid-fasttools-repair-references__panel {
    flex-direction:                                       column;
    flex-shrink:                                          0;
    margin-bottom:                                        12px;
    padding:                                              10px;
    border-radius:                                        6px;
    border-width:                                         1px;
    border-color:                                         var(--aspid-colors-shade-darkness);
    background-color:                                     var(--aspid-colors-surface-card);
}

.aspid-fasttools-repair-references__panel-title {
    padding-left:                                           4px;
    margin-bottom:                                          2px;
}

/* Space the plain label because the button's :root margin wins an equal-specificity rule. */
.aspid-fasttools-repair-references__panel-description {
    padding-left:                                           4px;
    color:                                                var(--aspid-colors-text-dark);
    white-space:                                          normal;
    margin-bottom:                                        12px;
}

/* The descendant selector outranks the gradient button's :root spacing rules. */
.aspid-fasttools-repair-references__panel
    .aspid-fasttools-repair-references__scan-project {
    margin:                                               0;
    padding-left:                                         4px;
    align-items:                                          center;
}

.aspid-fasttools-repair-references__scan-project .aspid-fasttools-gradient-button__label {
    color:                                                var(--aspid-colors-status-success-text-dark);
}

.aspid-fasttools-repair-references__scan-project-icon {
    flex-shrink:                                          0;
    width:                                                14px;
    height:                                               14px;
    margin:                                               0 6px 0 2px;
    -unity-background-image-tint-color:                   var(--aspid-colors-status-success-text-dark);
}

/* Stacked from the top: ReferenceEmptyStateLayout sets the top padding that puts the icon at the middle of the
   viewport, so the icon does not move with the text under it. */
.aspid-fasttools-repair-references__empty {
    flex-grow:                                             1;
    padding:                                               20px;
    align-items:                                           center;
    justify-content:                                       flex-start;
}

.aspid-fasttools-repair-references__empty--hidden {
    display:                                               none;
}

.aspid-fasttools-repair-references__empty-icon {
    width:                                                 96px;
    height:                                                96px;
    opacity:                                               0.9;
    margin-bottom:                                         14px;
    background-size:                                       contain;
    background-repeat:                                     no-repeat;
    background-position:                                   center;
}

.aspid-fasttools-repair-references__empty-icon--info {
    background-image:                                      var(--aspid-icons-status-info);
}

.aspid-fasttools-repair-references__empty-icon--success {
    background-image:                                      var(--aspid-icons-status-success);
}

.aspid-fasttools-repair-references__empty-title {
    margin-bottom:                                         4px;
}

.aspid-fasttools-repair-references__empty-message {
    max-width:                                             420px;
    color:                                                 var(--aspid-colors-text-dark);
    white-space:                                           normal;
    -unity-text-align:                                     middle-center;
}

.aspid-fasttools-repair-references__results {
    flex-grow:                                             1;
}

.aspid-fasttools-repair-references__results--hidden {
    display:                                               none;
}

.aspid-fasttools-repair-references__results-header {
    margin-bottom:                                         10px;
}

.aspid-fasttools-repair-references__results-hint {
    margin-top:                                            -4px;
    margin-bottom:                                         10px;
    color:                                                 var(--aspid-colors-text-dark);
    white-space:                                           normal;
}

/* With nothing that needs attention the hint takes no line; how to act on the results is the header's tooltip. */
.aspid-fasttools-repair-references__results-hint--hidden {
    display:                                               none;
}

/* Broken and Renamed sections, shown when both kinds are on screen. */
.aspid-fasttools-repair-references__section-heading {
    margin-top:                                            14px;
    margin-bottom:                                         10px;
}

.aspid-fasttools-repair-references__section-heading--first {
    margin-top:                                            0;
}

.aspid-fasttools-repair-references__summary {
    margin-bottom:                                         10px;
}

/* The status-qualified selector outranks the help box's warning background rule. */
.aspid-fasttools-repair-references__results
    .aspid-fasttools-repair-references__summary.aspid-fasttools-status--warning {
    background-color:                                      var(--aspid-colors-status-warning-tint);
    border-color:                                          var(--aspid-colors-status-warning-shade-dark);
}

/* The undo of a repair sits in the corner of its summary box. */
.aspid-fasttools-repair-references__summary
    .aspid-fasttools-repair-references__summary-undo {
    position:                                              absolute;
    top:                                                   6px;
    right:                                                 12px;
    height:                                                20px;
    padding:                                               0 12px;
    border-color:                                          var(--aspid-colors-status-warning-shade-dark);
}

/* Growing the content container centers short content while taller content remains scrollable. */
.aspid-fasttools-repair-references__scroll {
    flex-grow:                                             1;
}

.aspid-fasttools-repair-references__scroll .unity-scroll-view__content-container {
    flex-grow:                                             1;
    flex-shrink:                                           0;
}

/* The fixed height gives ListView the bounds required for virtualization. */
.aspid-fasttools-repair-references__picker.aspid-fasttools-background {
    flex-grow:                                             0;
    height:                                                300px;
    padding:                                               0;
    overflow:                                              hidden;
    margin:                                                0 -2px 8px -2px;
    border-radius:                                         6px;
    border-width:                                          1px;
    border-color:                                          var(--aspid-colors-shade-dark);
    background-color:                                      var(--aspid-colors-surface-card);
}

.aspid-fasttools-repair-references__picker--attached.aspid-fasttools-background {
    border-width:                                          0;
    border-radius:                                         0;
    background-color:                                      rgba(0, 0, 0, 0);
}

.aspid-fasttools-repair-references__picker
    .aspid-fasttools-type-selector__header {
    background-color:                                       rgba(0, 0, 0, 0);
    margin:                                                 0;
    margin-bottom:                                          5px;
}

.aspid-fasttools-repair-references__picker--attached
    .aspid-fasttools-type-selector__header {
    border-radius:                                         6px;
}

.aspid-fasttools-repair-references__picker
    .aspid-fasttools-type-selector__footer {
    margin: 5px -7px 0;
}

.aspid-fasttools-repair-references__picker--attached
    .aspid-fasttools-type-selector__footer {
    margin: 5px 0 0 0;
    border-top-width: 0;
    border-radius: 6px;
}

.aspid-fasttools-type-selector .aspid-fasttools-type-selector__item-content {
    border-radius: 8px;
    padding-left: 8px;
}

.aspid-fasttools-repair-references__group.aspid-fasttools-background {
    flex-grow:                                             0;
    margin-bottom:                                         10px;
    padding:                                               8px 10px;
    border-radius:                                         6px;
    border-width:                                          1px;
    border-color:                                          var(--aspid-colors-shade-darkness);
    background-color:                                      var(--aspid-colors-surface-card);
}

.aspid-fasttools-repair-references__group--picking.aspid-fasttools-background {
    border-color: var(--aspid-colors-status-warning-shade-light);

}

.aspid-fasttools-repair-references__group--migrate.aspid-fasttools-repair-references__group--picking.aspid-fasttools-background {
    border-color: var(--aspid-colors-status-info-shade-light);
}

/* Override row_bg rather than background-color to preserve the divider zone; the compound selectors outrank the base picker state rules. */
.aspid-fasttools-repair-references__group--picking .aspid-fasttools-type-selector__header--search-focused {
    border-color: var(--aspid-colors-status-warning-text-light);
}

.aspid-fasttools-repair-references__group--picking .aspid-fasttools-type-selector__search-button:hover {
    -unity-background-image-tint-color: var(--aspid-colors-status-warning-text-light);
}

.aspid-fasttools-repair-references__group--picking .aspid-fasttools-type-selector__breadcrumb--link:hover {
    color: var(--aspid-colors-status-warning-text-lightness);
}
/* Keep hover before selection so a hovered selected row retains its selection color. */
.aspid-fasttools-repair-references__group--picking .aspid-fasttools-type-selector
    .unity-collection-view__item.aspid-fasttools-type-selector__item:hover {
    --aspid-fasttools-colors-type_selector-row_bg: var(--aspid-colors-status-warning-shade-darkness);
}

.aspid-fasttools-repair-references__group--picking .aspid-fasttools-type-selector
    .unity-collection-view__item--selected.aspid-fasttools-type-selector__item,
.aspid-fasttools-repair-references__group--picking .aspid-fasttools-type-selector
    .unity-collection-view__item--selected.aspid-fasttools-type-selector__item:hover,
.aspid-fasttools-repair-references__group--picking .aspid-fasttools-type-selector
    .unity-collection-view:focus .unity-collection-view__item--selected.aspid-fasttools-type-selector__item {
    --aspid-fasttools-colors-type_selector-row_bg: var(--aspid-colors-status-warning-shade-dark);
}

.aspid-fasttools-repair-references__group--migrate .aspid-fasttools-type-selector__header--search-focused {
    border-color: var(--aspid-colors-status-info-text-light);
}

.aspid-fasttools-repair-references__group--migrate .aspid-fasttools-type-selector__search-button:hover {
    -unity-background-image-tint-color: var(--aspid-colors-status-info-text-light);
}

.aspid-fasttools-repair-references__group--migrate .aspid-fasttools-type-selector__breadcrumb--link:hover {
    color: var(--aspid-colors-status-info-text-lightness);
}
.aspid-fasttools-repair-references__group--migrate .aspid-fasttools-type-selector
    .unity-collection-view__item.aspid-fasttools-type-selector__item:hover {
    --aspid-fasttools-colors-type_selector-row_bg: var(--aspid-colors-status-info-shade-darkness);
}

.aspid-fasttools-repair-references__group--migrate .aspid-fasttools-type-selector
    .unity-collection-view__item--selected.aspid-fasttools-type-selector__item,
.aspid-fasttools-repair-references__group--migrate .aspid-fasttools-type-selector
    .unity-collection-view__item--selected.aspid-fasttools-type-selector__item:hover,
.aspid-fasttools-repair-references__group--migrate .aspid-fasttools-type-selector
    .unity-collection-view:focus .unity-collection-view__item--selected.aspid-fasttools-type-selector__item {
    --aspid-fasttools-colors-type_selector-row_bg: var(--aspid-colors-status-info-shade-dark);
}

/* The card scope outranks the gradient button's :root spacing rules. */
.aspid-fasttools-repair-references__group
    .aspid-fasttools-repair-references__group-fix-all {
    flex-direction:                                        row;
    align-items:                                           center;
    height:                                                auto;
    padding:                                               4px 4px;
    margin-bottom:                                         6px;
    --aspid-fasttools-colors-gradient_button-bg:           rgba(0, 0, 0, 0);
    --aspid-fasttools-colors-gradient_button-accent: var(
        --aspid-colors-status-warning-text-light
    );
}

.aspid-fasttools-repair-references__group--picking
    .aspid-fasttools-repair-references__group-fix-all {
    margin-bottom:                                         0;
}

/* The action takes its card's status colour, as the bands of Asset References do: amber to fix, blue to migrate. */
.aspid-fasttools-repair-references__group-fix-all
    .aspid-fasttools-gradient-button__label {
    flex-shrink:                                           0;
    margin-left:                                           8px;
    -unity-text-align:                                     middle-right;
    color:                                                 var(--aspid-colors-status-warning-text-light);
}

.aspid-fasttools-repair-references__group
    .aspid-fasttools-repair-references__group-fix-all--migrate {
    --aspid-fasttools-colors-gradient_button-accent: var(
        --aspid-colors-status-info-text-light
    );
}

.aspid-fasttools-repair-references__group-fix-all--migrate
    .aspid-fasttools-gradient-button__label {
    color:                                                 var(--aspid-colors-status-info-text-light);
}

/* USS cannot select the sibling sweep from button hover; code mirrors hover onto the card modifier. */

.aspid-fasttools-repair-references__group-divider {
    flex-grow:                                             0;
    margin-top:                                            -2px;
    margin-bottom:                                         4px;
    opacity:                                               0.5;
}

/* The negative margin overlays the divider; the bottom margin restores the displaced gap. */
.aspid-fasttools-repair-references__group-sweep {
    height:                                                1px;
    margin-top:                                            -5px;
    margin-bottom:                                         4px;
    background-color:                                      var(--aspid-colors-status-warning-text-dark);
    transform-origin:                                      left;
    scale:                                                 0 1;
    transition-property:                                   scale;
    transition-duration:                                   0.25s;
    transition-timing-function:                            ease-out;
}

.aspid-fasttools-repair-references__group-sweep--migrate {
    background-color:                                      var(--aspid-colors-status-info-text-dark);
}

.aspid-fasttools-repair-references__group--header-hover .aspid-fasttools-repair-references__group-sweep {
    scale:                                                 1 1;
}

.aspid-fasttools-repair-references__group--picking .aspid-fasttools-repair-references__group-divider,
.aspid-fasttools-repair-references__group--picking .aspid-fasttools-repair-references__group-sweep {
    display:                                               none;
}

/* In a narrow window the count gives way first and the title after it, both with an ellipsis; Fix all keeps its width. */
.aspid-fasttools-repair-references__group-header-row {
    flex-direction:                                        row;
    flex-shrink:                                           1;
    align-items:                                           center;
    min-width:                                             0;
    overflow:                                              hidden;
}

.aspid-fasttools-repair-references__group-header {
    flex-shrink:                                           1;
    min-width:                                             0;
    overflow:                                              hidden;
}

/* The type selector of the label's own sheet lets its text wrap; this keeps the title on one line. */
.aspid-fasttools-repair-references__group-header Label {
    flex-shrink:                                           1;
    min-width:                                             0;
    overflow:                                              hidden;
    text-overflow:                                         ellipsis;
    white-space:                                           nowrap;
}

.aspid-fasttools-repair-references__group-count {
    flex-shrink:                                           100;
    min-width:                                             0;
    margin-left:                                           10px;
    overflow:                                              hidden;
    text-overflow:                                         ellipsis;
    white-space:                                           nowrap;
    color:                                                 var(--aspid-colors-text-dark);
    -unity-font-style:                                     normal;
}

/* A long target type is cut in the middle, so both the action and the class name stay readable. */
.aspid-fasttools-repair-references__group-action {
    padding:                                               2px 4px;
    overflow:                                              hidden;
    text-overflow:                                         ellipsis;
    white-space:                                           nowrap;
    -unity-text-overflow-position:                         middle;
    border-radius:                                         3px;
    cursor:                                                link;
    -unity-font-style:                                     bold;
    color:                                                 var(--aspid-colors-status-warning-text-dark);
    transition-property:                                   background-color, color;
    transition-duration:                                   0.25s;
    transition-timing-function:                            ease-out;
}

.aspid-fasttools-repair-references__group-action:hover {
    background-color:                                      var(--aspid-colors-bg-dark);
    color:                                                 var(--aspid-colors-status-warning-text-light);
}

.aspid-fasttools-repair-references__group-action--info {
    color:                                                 var(--aspid-colors-status-info-text-dark);
}

.aspid-fasttools-repair-references__group-action--info:hover {
    color:                                                 var(--aspid-colors-status-info-text-light);
}

.aspid-fasttools-repair-references__group-more {
    padding:                                               2px 4px;
    border-radius:                                         3px;
    cursor:                                                link;
    color:                                                 var(--aspid-colors-text-dark);
    transition-property:                                   background-color, color;
    transition-duration:                                   0.25s;
    transition-timing-function:                            ease-out;
}

/* Show more files sits under the last file card of its section, outside the cards. */
.aspid-fasttools-repair-references__files-more {
    align-self:                                            flex-start;
    margin-bottom:                                         10px;
}

.aspid-fasttools-repair-references__group-more:hover {
    background-color:                                      var(--aspid-colors-bg-dark);
    color:                                                 var(--aspid-colors-text-light);
}

.aspid-fasttools-repair-references__group-entry {
    flex-direction:                                        row;
    align-items:                                           center;
    padding:                                               2px 4px;
    border-radius:                                         3px;
    cursor:                                                link;

    transition-property:                                   background-color;
    transition-duration:                                   0.25s;
    transition-timing-function:                            ease-out;
}

.aspid-fasttools-repair-references__group-entry:hover {
    background-color:                                      var(--aspid-colors-bg-dark);
}

.aspid-fasttools-repair-references__group-entry-path {
    flex-direction:                                        row;
    flex-grow:                                             1;
    flex-shrink:                                           1;
    min-width:                                             0;
    overflow:                                              hidden;
}

/* The folder gives way long before the file name (flex-shrink 100 to 1) and loses its start first. */
.aspid-fasttools-repair-references__group-entry-folder {
    flex-shrink:                                           100;
    min-width:                                             0;
    margin:                                                0;
    padding:                                               0;
    overflow:                                              hidden;
    text-overflow:                                         ellipsis;
    -unity-text-overflow-position:                         start;
    white-space:                                           nowrap;
    color:                                                 var(--aspid-colors-text-dark);
    cursor:                                                text;
}

.aspid-fasttools-repair-references__group-entry-file {
    flex-shrink:                                           1;
    min-width:                                             0;
    margin:                                                0;
    padding:                                               0;
    overflow:                                              hidden;
    text-overflow:                                         ellipsis;
    white-space:                                           nowrap;
    color:                                                 var(--aspid-colors-text-lightness);
    cursor:                                                text;
}

/* A row of a file card: what differs between the entries of that file, a field or a type. */
.aspid-fasttools-repair-references__group-entry-name {
    flex-grow:                                             1;
    flex-shrink:                                           1;
    min-width:                                             0;
    overflow:                                              hidden;
    text-overflow:                                         ellipsis;
    white-space:                                           nowrap;
    color:                                                 var(--aspid-colors-text-light);
    cursor:                                                text;
}

/* The path that heads a file card of the Required and Prefab instance overrides sections, with the entry count right
   after it, as a group card's count follows its title. */
/* Spaced like a group card's Fix all band (padding 4px, margin-bottom 6px), so the divider under it keeps the same
   distance from the text in both kinds of cards. */
.aspid-fasttools-repair-references__file-header {
    padding-top:                                           4px;
    padding-bottom:                                        4px;
    margin-bottom:                                         6px;
}

.aspid-fasttools-repair-references__file-header .aspid-fasttools-repair-references__group-entry-file {
    -unity-font-style:                                     bold;
}

.aspid-fasttools-repair-references__file-header .aspid-fasttools-repair-references__group-entry-path {
    flex-grow:                                             0;
}

.aspid-fasttools-repair-references__file-header .aspid-fasttools-repair-references__group-count {
    flex-shrink:                                           0;
}

.aspid-fasttools-repair-references__group-entry-rid {
    flex-shrink:                                           0;
    margin-left:                                           10px;
    color:                                                 var(--aspid-colors-text-dark);
    -unity-text-align:                                     middle-right;
    cursor:                                                text;
}

.aspid-fasttools-repair-references__group-entry-field {
    flex-shrink:                                           0;
    margin-left:                                           10px;
    color:                                                 var(--aspid-colors-text-dark);
    -unity-text-align:                                     middle-right;
    cursor:                                                text;
}

/* Gradient buttons use their animated hover in code; applying this flat fill would show through the gradient. */
.aspid-fasttools-repair-references__nav-target--focused {
    background-color:                                      var(--aspid-colors-bg-dark);
}

.aspid-fasttools-repair-references__group-action.aspid-fasttools-repair-references__nav-target--focused {
    color:                                                 var(--aspid-colors-status-warning-text-light);
}

.aspid-fasttools-repair-references__group-action--info.aspid-fasttools-repair-references__nav-target--focused {
    color:                                                 var(--aspid-colors-status-info-text-light);
}

.aspid-fasttools-repair-references__group-more.aspid-fasttools-repair-references__nav-target--focused {
    color:                                                 var(--aspid-colors-text-light);
}

.aspid-fasttools-serialize-reference--drop-target {
    background-color:                                      var(--unity-colors-helpbox-background);
    border-left-width:                                     2px;
    border-left-color:                                     var(--aspid-colors-status-info-light);
}
