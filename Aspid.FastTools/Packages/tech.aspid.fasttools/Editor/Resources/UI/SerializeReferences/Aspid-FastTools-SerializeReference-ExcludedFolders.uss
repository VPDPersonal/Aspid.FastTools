.aspid-fasttools-excluded-folders {
    margin-bottom:                                        2px;
}

/* The caption and the list share one framed block, as the fields of an EnumValues row do. The block starts so that
   the caption's text sits where the captions of the other rows sit, and it ends where the control column ends. */
.aspid-fasttools-excluded-folders__box {
    margin:                                               2px 4px 2px 8px;
    padding:                                              0 4px 4px 4px;
    border-width:                                         1px;
    border-color:                                         var(--aspid-colors-control-border);
    border-radius:                                        var(--aspid-radius-card);
}

.aspid-fasttools-excluded-folders__caption {
    min-height:                                           24px;
    margin:                                               0;
    padding:                                              0 0 0 5px;
    color:                                                var(--aspid-colors-text-light);
    -unity-text-align:                                    middle-left;
}

.aspid-fasttools-excluded-folders__list {
    margin:                                               0;
    padding:                                              2px 0;
    border-width:                                         1px;
    border-color:                                         var(--aspid-colors-control-border);
    border-radius:                                        var(--aspid-radius-control);
    background-color:                                     var(--aspid-colors-surface-card-dim);
}

.aspid-fasttools-excluded-folders__empty {
    flex-grow:                                            1;
    padding:                                              0;
    color:                                                var(--aspid-colors-text-dark);
    -unity-text-align:                                    middle-left;
}

/* The transparent border reserves the space of the keyboard focus border, so the rows do not shift on focus. */
.aspid-fasttools-excluded-folders__entry {
    flex-direction:                                       row;
    align-items:                                          center;
    min-height:                                           22px;
    margin:                                               0 2px;
    padding:                                              0 1px 0 6px;
    border-width:                                         1px;
    border-color:                                         rgba(0, 0, 0, 0);
    border-radius:                                        var(--aspid-radius-control);
}

.aspid-fasttools-excluded-folders__entry:hover {
    background-color:                                     var(--aspid-colors-overlay-hover);
}

.aspid-fasttools-excluded-folders__entry--selected,
.aspid-fasttools-excluded-folders__entry--selected:hover {
    background-color:                                     var(--aspid-colors-accent-shade-dark);
}

.aspid-fasttools-excluded-folders__path {
    flex-grow:                                            1;
    flex-shrink:                                          1;
    min-width:                                            0;
    color:                                                var(--aspid-colors-text-light);
    text-overflow:                                        ellipsis;
    overflow:                                             hidden;
    white-space:                                          nowrap;
    -unity-text-align:                                    middle-left;
}

.aspid-fasttools-excluded-folders__entry--selected .aspid-fasttools-excluded-folders__path {
    color:                                                var(--aspid-colors-text-lightness);
}

/* The "−" of a row and the "+" of the last row. The transparent border reserves the space of the keyboard focus
   border. */
.aspid-fasttools-excluded-folders__row-button {
    flex-shrink:                                          0;
    width:                                                20px;
    height:                                               18px;
    margin:                                               0 0 0 2px;
    padding:                                              0;
    border-width:                                         1px;
    border-color:                                         rgba(0, 0, 0, 0);
    border-radius:                                        3px;
    background-color:                                     rgba(0, 0, 0, 0);
    color:                                                var(--aspid-colors-text-dark);
    font-size:                                            14px;
    -unity-text-align:                                    middle-center;
}

/* Holds the place of the "+" on the rows before the last one. */
.aspid-fasttools-excluded-folders__row-slot {
    border-width:                                         0;
}

.aspid-fasttools-excluded-folders__add:hover {
    background-color:                                     var(--aspid-colors-overlay-hover);
    color:                                                var(--aspid-colors-text-lightness);
}

/* Removing has no Undo, so the "−" turns red on hover. */
.aspid-fasttools-excluded-folders__remove:hover {
    background-color:                                     var(--aspid-colors-status-error-tint);
    color:                                                var(--aspid-colors-status-error-text-light);
}
