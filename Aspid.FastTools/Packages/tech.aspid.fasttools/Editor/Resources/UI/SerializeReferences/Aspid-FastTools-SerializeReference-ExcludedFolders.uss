.aspid-fasttools-excluded-folders {
    margin-bottom:                                        2px;
}

/* The transparent border reserves the space of the keyboard focus border, so the rows do not shift on focus. */
.aspid-fasttools-excluded-folders__header {

    margin-left:                                          9px;
    flex-direction:                                       row;
    align-items:                                          center;
    min-height:                                           26px;
    padding:                                              1px 3px 1px 7px;
    border-width:                                         1px;
    border-color:                                         rgba(0, 0, 0, 0);
    border-radius:                                        6px;
    transition-property:                                  background-color;
    transition-duration:                                  0.25s;
    transition-timing-function:                           ease-out;
}

.aspid-fasttools-excluded-folders__header--add {
    background-color:                                     var(--aspid-colors-bg-dark);
}

.aspid-fasttools-excluded-folders__header-caption {
    flex-grow:                                            1;
    color:                                                var(--aspid-colors-text-light);
    -unity-text-align:                                    middle-left;
}

/* The folders sit in a framed box under the caption, bordered like the drop-downs and object fields, so they read as
   a list. It starts where the caption's text starts and ends where the control column ends. */
.aspid-fasttools-excluded-folders__list {
    margin:                                               2px 4px 4px 19px;
    padding:                                              2px;
    border-width:                                         1px;
    border-color:                                         var(--aspid-colors-control-border);
    border-radius:                                        6px;
    background-color:                                     var(--aspid-colors-surface-card-dim);
}

.aspid-fasttools-excluded-folders__empty {
    min-height:                                           22px;
    padding:                                              1px 8px;
    color:                                                var(--aspid-colors-text-dark);
    -unity-text-align:                                    middle-left;
}

.aspid-fasttools-excluded-folders__add {
    flex-shrink:                                          0;
    width:                                                18px;
    height:                                               18px;
    margin:                                               0 2px 0 4px;
    padding:                                              0;
    border-width:                                         0;
    border-radius:                                        3px;
    background-color:                                     rgba(0, 0, 0, 0);
    color:                                                var(--aspid-colors-text-light);
    font-size:                                            16px;
    -unity-text-align:                                    middle-center;
}

.aspid-fasttools-excluded-folders__header--add .aspid-fasttools-excluded-folders__add {
    color:                                                var(--aspid-colors-accent-text-light);
}

/* Code mirrors child hover onto the row because USS cannot select a parent from child hover. */
.aspid-fasttools-excluded-folders__entry {

    flex-direction:                                       row;
    align-items:                                          center;
    min-height:                                           22px;
    padding:                                              1px 3px 1px 8px;
    border-width:                                         1px;
    border-color:                                         rgba(0, 0, 0, 0);
    border-radius:                                        6px;
    transition-property:                                  background-color;
    transition-duration:                                  0.25s;
    transition-timing-function:                           ease-out;
}

.aspid-fasttools-excluded-folders__entry--hover {
    background-color:                                     var(--aspid-colors-bg-dark);
}

.aspid-fasttools-excluded-folders__entry--danger {
    background-color:                                     var(--aspid-colors-status-error-tint);
}

.aspid-fasttools-excluded-folders__path {
    flex-grow:                                            1;
    flex-shrink:                                          1;
    min-width:                                            0;
    align-self:                                           stretch;
    color:                                                var(--aspid-colors-text-light);
    text-overflow:                                        ellipsis;
    overflow:                                             hidden;
    white-space:                                          nowrap;
    -unity-text-align:                                    middle-left;
}

.aspid-fasttools-excluded-folders__remove {
    flex-shrink:                                          0;
    width:                                                18px;
    height:                                               18px;
    margin:                                               0 2px 0 4px;
    padding:                                              0;
    border-width:                                         0;
    border-radius:                                        3px;
    background-color:                                     rgba(0, 0, 0, 0);
    color:                                                var(--aspid-colors-text-dark);
    font-size:                                            12px;
    -unity-text-align:                                    middle-center;
}

.aspid-fasttools-excluded-folders__entry--danger .aspid-fasttools-excluded-folders__remove {
    background-color:                                     var(--aspid-colors-status-error-light);
    color:                                                var(--aspid-colors-status-error-text-lightness);
}
