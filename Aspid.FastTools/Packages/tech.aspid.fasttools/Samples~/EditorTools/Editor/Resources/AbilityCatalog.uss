.ability-catalog {
    background-color: var(--aspid-colors-surface-card);
}

.ability-list {
    border-right-width: 1px;
    border-right-color: var(--aspid-colors-shade-dark);
}

.ability-details {
    padding: 12px;
}

.ability-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: var(--aspid-colors-accent-text-light);
}
