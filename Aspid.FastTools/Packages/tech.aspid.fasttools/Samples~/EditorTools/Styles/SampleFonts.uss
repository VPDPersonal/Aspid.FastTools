.ability-catalog, .ability-catalog * {
    -unity-font-definition: initial;
    -unity-font: url("../Fonts/iAWriterQuattroS-Regular.ttf");
}

.ability-catalog .ability-title {
    -unity-font: url("../Fonts/IBMPlexSerif-Regular.ttf");
}

.ability-catalog #abilityStats {
    -unity-font: url("../Fonts/IBMPlexMono-Regular.ttf");
}
