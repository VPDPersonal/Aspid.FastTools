.aspid-fasttools-inspector-notice {
    flex-direction:                                        row;
    align-items:                                           center;
    flex-wrap:                                             wrap;

    margin:                                                2px 0 1px 2px;
}

.aspid-fasttools-inspector-notice__icon {
    width:                                                 14px;
    height:                                                14px;
    min-width:                                             14px;
    margin-right:                                          5px;
    background-size:                                       contain;
    background-repeat:                                     no-repeat;
    background-position:                                   center;
    background-image:                                      resource("d_console.warnicon");
}

.aspid-fasttools-inspector-notice__message {
    color:                                                 var(--aspid-colors-status-warning-text-light);
    -unity-font-style:                                     normal;
    white-space:                                           normal;
}

.aspid-fasttools-inspector-notice__message--navigable {
    cursor:                                                link;
}

.aspid-fasttools-inspector-notice__action {
    margin-left:                                           auto;
    color:                                                 var(--aspid-colors-status-warning-text-light);
    -unity-font-style:                                     bold;
    cursor:                                                link;
}

.aspid-fasttools-inspector-notice__action:hover {
    color:                                                 var(--aspid-colors-status-warning-text-lightness);
}

.aspid-fasttools-inspector-notice__suggestion {
    margin-left:                                           6px;
    color:                                                 var(--aspid-colors-status-warning-text-light);
    -unity-font-style:                                     bold;
    cursor:                                                link;
    display:                                               none;
}

.aspid-fasttools-inspector-notice__suggestion--visible {
    display:                                               flex;
}

.aspid-fasttools-inspector-notice__suggestion-separator {
    margin-left:                                           6px;
    color:                                                 var(--aspid-colors-status-warning-text-light);
    -unity-font-style:                                     bold;
    display:                                               none;
}

.aspid-fasttools-inspector-notice__suggestion-separator--visible {
    display:                                               flex;
}

.aspid-fasttools-inspector-notice__suggestion:hover {
    color:                                                 var(--aspid-colors-status-warning-text-lightness);
}

.aspid-fasttools-inspector-notice__dot {
    width:                                                 8px;
    height:                                                8px;
    min-width:                                             8px;
    margin-right:                                          6px;
    border-radius:                                         4px;
    display:                                               none;
}

.aspid-fasttools-inspector-notice__dot--visible {
    display:                                               flex;
}

.aspid-fasttools-inspector-notice--shared
    .aspid-fasttools-inspector-notice__icon {
    display:                                              none;
}

.aspid-fasttools-inspector-notice--info
    .aspid-fasttools-inspector-notice__icon {
    background-image:                                      resource("d_console.infoicon");
}

.aspid-fasttools-inspector-notice--info
    .aspid-fasttools-inspector-notice__message {
    color:                                                 var(--aspid-colors-text-dark);
}
