/* The bare TextElement does not inherit popup-field ellipsis rules, so all overflow properties are required here.
   The ellipsis starts the text, so the class name at its end stays visible. */
.aspid-fasttools-type-field__text--missing {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-overflow-position: start;
    color: var(--unity-colors-warning-text);
}

Button.aspid-fasttools-type-field__open-button {
    padding:                0;
    min-width:              18px;
    max-width:              18px;
    min-height:             18px;
    max-height:             18px;
    margin:                 0 0 0 1px;
}

.aspid-fasttools-type-field__open-icon {
    width:                  100%;
    height:                 100%;
    background-image:       resource("d_Folder Icon");
}

.aspid-fasttools-type-field__open-button:enabled:hover > .aspid-fasttools-type-field__open-icon {
    background-image:       resource("d_FolderOpened Icon");
}

.aspid-fasttools-skin--light .aspid-fasttools-type-field__open-icon {
    background-image:       resource("Folder Icon");
}

.aspid-fasttools-skin--light .aspid-fasttools-type-field__open-button:enabled:hover > .aspid-fasttools-type-field__open-icon {
    background-image:       resource("FolderOpened Icon");
}
