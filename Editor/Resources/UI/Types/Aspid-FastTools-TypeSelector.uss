.aspid-fasttools-type-selector {
    --aspid-fasttools-colors-type_selector-row_bg: rgba(0, 0, 0, 0);
    padding:                5px 2px;
    flex-grow:              1;
    flex-direction:         column;
}

.aspid-fasttools-type-selector__header {
    min-height:             20px;
    flex-shrink:            0;
    flex-direction:         row;
    align-items:            center;
    flex-wrap:              nowrap;
    overflow:               hidden;
    padding:                2px 5px;
    margin:                 -5px -2px 5px;
    background-color:       var(--aspid-colors-bg-dark);
    border-width:           1px;
    border-color:           var(--aspid-colors-bg-dark);
}

.aspid-fasttools-type-selector__header--search-focused {
    border-color:           var(--aspid-colors-status-info-text-light);
}

.aspid-fasttools-type-selector__trail {
    flex-grow:              1;
    flex-shrink:            1;
    min-height:             16px;
    flex-direction:         row;
    align-items:            center;
    flex-wrap:              nowrap;
    overflow:               hidden;
    cursor:                 text;
}

.aspid-fasttools-type-selector__search-button {
    width:                  11px;
    height:                 11px;
    margin:                 0 4px 0 2px;
    padding:                0;
    flex-shrink:            0;
    align-items:            center;
    border-width:           0;
    border-radius:          3px;
    background-color:       rgba(0, 0, 0, 0);
}

.aspid-fasttools-type-selector__search-button:hover {
    -unity-background-image-tint-color:  var(--aspid-colors-status-info-text-light);
}

/* Clear ToolbarSearchField's intrinsic maximum width; negative margins cancel the surrounding header padding. */
/* The header clips the field's border corners, so the header supplies the frame instead. */
.aspid-fasttools-type-selector__search-field {
    width:                  auto;
    max-width:              none;
    flex-grow:              1;
    flex-shrink:            1;
    align-self:             stretch;
    margin:                 0;
    border-width:           0;
    border-radius:          0;
    background-color:       rgba(0, 0, 0, 0);
}

.aspid-fasttools-type-selector__search-field
    .unity-search-field-base__text-field {
    flex-grow:              1;
    max-width:              none;
}

.aspid-fasttools-type-selector__search-field .unity-base-text-field__input {
    font-size:              12px;
    border-width:           0;
    border-radius:          0;
    background-color:       rgba(0, 0, 0, 0);
}

.aspid-fasttools-type-selector__search-field
    .unity-search-field-base__search-button {
    width:                  11px;
    height:                 11px;
}

ToolbarSearchField TextElement {
    font-size:      12px;
    -unity-font-style:      bold;
}

.aspid-fasttools-type-selector__breadcrumb {
    font-size:              12px;
    -unity-font-style:      bold;
    color:                  var(--aspid-colors-text-light);
    flex-shrink:            1;
    overflow:               hidden;
    text-overflow:          ellipsis;
    white-space:            nowrap;
}

.aspid-fasttools-type-selector__breadcrumb--current {
    color:                  var(--aspid-colors-text-lightness);
}

.aspid-fasttools-type-selector__breadcrumb--link {
    cursor:                 link;
}

.aspid-fasttools-type-selector__breadcrumb--link:hover {
    color:                  var(--aspid-colors-status-info-text-lightness);
}

.aspid-fasttools-type-selector__breadcrumb-separator {
    margin:                 0 4px;
    flex-shrink:            0;
    color:                  var(--aspid-colors-text-dark);
}

.aspid-fasttools-type-selector .unity-list-view {
    flex-grow:              1;
}

.aspid-fasttools-type-selector__error {
    margin:                 2px 4px;
    flex-shrink:            0;
    white-space:            normal;
    color:                  var(--aspid-colors-status-error-text-light);
}

.aspid-fasttools-type-selector__empty-hint {
    flex-grow:              1;
    padding:                20px;
    white-space:            normal;
    -unity-text-align:      middle-center;
    color:                  var(--aspid-colors-text-dark);
}

.aspid-fasttools-type-selector__footer {
    margin:                 5px -2px -5px;
    padding:                3px 8px;
    flex-direction:         row;
    align-items:            center;
    flex-shrink:            0;
    background-color:       var(--aspid-colors-bg-dark);
    border-top-width:       1px;
    border-top-color:       var(--aspid-colors-shade-darkness);
}

.aspid-fasttools-type-selector__footer-hint {
    flex-grow:              1;
    flex-shrink:            1;
    overflow:               hidden;
    white-space:            nowrap;
    text-overflow:          ellipsis;
    font-size:              12px;
    color:                  var(--aspid-colors-text-darkness);
}

.aspid-fasttools-type-selector__settings-button {
    width:                  14px;
    height:                 14px;
    margin:                 0 0 0 8px;
    padding:                0;
    flex-shrink:            0;
    border-width:           0;
    border-radius:          3px;
    background-color:       rgba(0, 0, 0, 0);
    background-image:       var(--aspid-icons-settings);
    -unity-background-image-tint-color: var(--aspid-colors-text-darkness);
}

.aspid-fasttools-type-selector__settings-button:hover {
    -unity-background-image-tint-color: var(--aspid-colors-text-light);
}

/* ListView owns row height and ignores item margins; a taller transparent shell reserves divider space above the fill-carrying content. */
.aspid-fasttools-type-selector .unity-collection-view__item {
    height:                 22px;
    padding:                0;
    align-items:            stretch;
    justify-content:        flex-end;
    flex-direction:         column;
}

/* Clear every shell state to prevent Unity's default hover and selection fills leaking through. */
.aspid-fasttools-type-selector .unity-collection-view__item:hover,
.aspid-fasttools-type-selector .unity-collection-view__item--selected,
.aspid-fasttools-type-selector .unity-collection-view__item--selected:hover,
.aspid-fasttools-type-selector .unity-collection-view:focus .unity-collection-view__item--selected {
    background-color:       rgba(0, 0, 0, 0);
}

.aspid-fasttools-type-selector__item-content {
    height:                 22px;
    flex-shrink:            0;
    align-items:            center;
    flex-direction:         row;
    padding-left:           1px;
    padding-right:          5px;
    background-color:       var(--aspid-fasttools-colors-type_selector-row_bg);
}

.aspid-fasttools-type-selector .unity-collection-view__item:hover {
    --aspid-fasttools-colors-type_selector-row_bg: var(--aspid-colors-status-info-shade-darkness);
}

.aspid-fasttools-type-selector .unity-collection-view__item--selected,
.aspid-fasttools-type-selector .unity-collection-view__item--selected:hover,
.aspid-fasttools-type-selector .unity-collection-view:focus .unity-collection-view__item--selected {
    --aspid-fasttools-colors-type_selector-row_bg: var(--aspid-colors-status-info-shade-dark);
}

.aspid-fasttools-type-selector
    .unity-collection-view__item.aspid-fasttools-type-selector__item--after-pinned {
    height:                 31px;
}

.aspid-fasttools-type-selector__item-divider {
    display:                none;
    position:               absolute;
    top:                    4px;
    left:                   0;
    right:                  0;
    height:                 1px;
    background-color:       var(--aspid-colors-shade-darkness);
}

.aspid-fasttools-type-selector__item--after-pinned > .aspid-fasttools-type-selector__item-divider {
    display:                flex;
}

.aspid-fasttools-type-selector__item {
    flex-grow:              1;
}

.aspid-fasttools-type-selector__item-icon {
    width:                  14px;
    height:                 14px;
    margin-right:           4px;
    flex-shrink:            0;
}

.aspid-fasttools-type-selector__item-icon--collapsed {
    opacity:                0.4;
}

.aspid-fasttools-type-selector__item-glyph {
    width:                  14px;
    height:                 14px;
    margin-right:           4px;
    flex-shrink:            0;
    font-size:              16px;
    -unity-text-align:      middle-center;
    color:                  var(--aspid-colors-text-light);
}

.aspid-fasttools-type-selector__item-title {
    color:                  var(--aspid-colors-text-lightness);
    flex-grow:              1;
}

.aspid-fasttools-type-selector__item-check {
    margin-left:            4px;
    flex-shrink:            0;
    font-size:              12px;
    -unity-font-style:      bold;
    color:                  var(--aspid-colors-status-success-text-dark);
}

.aspid-fasttools-type-selector__item--current
    .aspid-fasttools-type-selector__item-title {
    -unity-font-style:      bold;
}

.aspid-fasttools-type-selector__item-count {
    margin-left:            4px;
    margin-right:           2px;
    flex-shrink:            0;
    font-size:              10px;
    color:                  var(--aspid-colors-text-dark);
}

.aspid-fasttools-type-selector__item-arrow {
    color:                  var(--aspid-colors-text-dark);
}

.aspid-fasttools-type-selector__favorite-toggle {
    margin:                 0;
    padding:                0;
    width:                  16px;
    height:                 16px;
    flex-shrink:            0;
    border-width:           0;
    font-size:              13px;
    -unity-text-align:      middle-center;
    background-color:       rgba(0, 0, 0, 0);
    color:                  var(--aspid-colors-text-darkness);
    opacity:                0;
}

.aspid-fasttools-type-selector__item:hover
    .aspid-fasttools-type-selector__favorite-toggle {
    opacity:                1;
}

.aspid-fasttools-type-selector
    .unity-collection-view__item--selected
    .aspid-fasttools-type-selector__favorite-toggle {
    opacity:                1;
}

.aspid-fasttools-type-selector__favorite-toggle--favorite-on {
    opacity:                1;
    color:                  var(--aspid-colors-status-warning-text-light);
}

.aspid-fasttools-type-selector__favorite-toggle:hover {
    color:                  var(--aspid-colors-status-warning-text-lightness);
}

.aspid-fasttools-type-selector__section-title {
    background-color:       rgba(0, 0, 0, 0);
    cursor:                 link;
}

.aspid-fasttools-type-selector__section-title
    .aspid-fasttools-type-selector__item-title {
    color:                  var(--aspid-colors-text-lightness);
    -unity-font-style:      bold;
}

.aspid-fasttools-type-selector__item--in-section {
    margin-left:            6px;
}
