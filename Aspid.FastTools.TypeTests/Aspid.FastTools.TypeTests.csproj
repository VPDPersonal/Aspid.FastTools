<Project Sdk="Microsoft.NET.Sdk">

    <!-- Runs the GenericTypeResolver NUnit tests outside Unity. The resolver, the TypeUtility it reads and the tests are
         compiled from the package sources as-is; Stubs/ stands in for the Unity types they name (UnityEngine.Object and
         the CompilationPipeline API of TypeUtility). -->
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <!-- The C# version of Unity 6000.0, so a newer language feature fails here as it would in Unity. -->
        <LangVersion>9.0</LangVersion>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Aspid.FastTools.Types.Editors.Tests</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <_Package>$(MSBuildThisFileDirectory)../Aspid.FastTools/Packages/tech.aspid.fasttools/</_Package>
        <_TypeSources>$(_Package)Editor/Scripts/Types/</_TypeSources>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="$(_TypeSources)TypeUtility.cs;
                          $(_TypeSources)Selectors/GenericTypeResolver.cs;
                          $(_TypeSources)Selectors/GenericArgumentFilter.cs"
                 Link="Types/%(Filename)%(Extension)" />
        <!-- GenericTypeResolverTests.Unity.cs holds the tests that need Unity types or the real argument filter of the
             Editor assembly; the Unity job runs them. -->
        <Compile Include="$(_Package)Tests/Editor/Types/GenericTypeResolverTests.cs"
                 Link="Tests/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- NUnit 3, the major version Unity's Test Framework ships: classic Assert/CollectionAssert as the tests use them. -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.2" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    </ItemGroup>

</Project>
