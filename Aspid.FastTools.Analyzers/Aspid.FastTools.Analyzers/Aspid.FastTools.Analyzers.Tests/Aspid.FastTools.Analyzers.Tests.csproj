<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.1"/>
        <!-- The test harness runs on Workspaces; pinned to the analyzer's Roslyn so it does not resolve to 1.0.1. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.3.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.2"/>
        <PackageReference Include="xunit" Version="2.4.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Aspid.FastTools.Analyzers\Aspid.FastTools.Analyzers.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <_PackageTypes>$(MSBuildThisFileDirectory)../../../Aspid.FastTools/Packages/tech.aspid.fasttools/Runtime/Scripts/Types/</_PackageTypes>
    </PropertyGroup>

    <ItemGroup>
        <!-- The package types the TypeSelector analyzer matches by full name. The tests compile these sources as-is, so
             a rename or a namespace move fails them, as it would silence the diagnostics in Unity. -->
        <EmbeddedResource Include="$(_PackageTypes)ISerializableType.cs;$(_PackageTypes)SerializableMonoScript.cs;$(_PackageTypes)SerializableType.cs;$(_PackageTypes)SerializableTypeBase.cs;$(_PackageTypes)TypeAllow.cs;$(_PackageTypes)TypeSelectorAttribute.cs"
                          LogicalName="PackageSources/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- The docs pages the rules' help links point to, so a renamed heading fails the tests. -->
        <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../Website/docs/*.md" LogicalName="Docs/%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
