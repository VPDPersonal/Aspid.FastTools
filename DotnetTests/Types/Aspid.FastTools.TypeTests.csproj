<Project Sdk="Microsoft.NET.Sdk">

    <!-- Runs the GenericTypeResolver and TypeUtility NUnit tests outside Unity. The tests are compiled from the package
         sources as-is against the resolver in Resolver/, an assembly of its own on .NET Standard 2.1. -->
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <!-- The C# version of Unity 6000.0, so a newer language feature fails here as it would in Unity. -->
        <LangVersion>9.0</LangVersion>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Aspid.FastTools.Tests.Editors.Types</RootNamespace>
        <!-- Resolver/ is a project of its own. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);Resolver/**</DefaultItemExcludes>
    </PropertyGroup>

    <PropertyGroup>
        <_TypeTests>$(MSBuildThisFileDirectory)../../Aspid.FastTools/Packages/tech.aspid.fasttools/Tests/Editor/Types/</_TypeTests>
    </PropertyGroup>

    <ItemGroup>
        <!-- A *.Unity.cs part holds the tests of its fixture that need Unity types or the Editor assembly (the real
             argument filter, TypeInfo); the Unity job runs them. -->
        <Compile Include="$(_TypeTests)GenericTypeResolverTests.cs;
                          $(_TypeTests)TypeUtilityTests.cs"
                 Link="Tests/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="Resolver/Aspid.FastTools.TypeResolver.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- NUnit 3, the major version Unity's Test Framework ships: classic Assert/CollectionAssert as the tests use them. -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.2" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    </ItemGroup>

</Project>
